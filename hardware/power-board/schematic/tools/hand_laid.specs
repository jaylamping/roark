/VWD=F:103.65,247.75 103.65,248.3 104.0,249.05 105.0,249.05 105.45,248.6 105.75,248.15
# GND island link
GND=F:161.0,236.8 161.4,237.0
# escapes re-laid at 0.2 mm when the fine-pitch pads were narrowed (U7's BRK_P round the BRK_IN via, U2's FB_CTL)
/BRK_P=F:138.6,124.2 137.7,120.95 136.2,119.6 135.4,120.0 135.4,120.2
/FB_CTL=F:109.4,154.605 110.45,154.605 110.45,156.45 109.7,157.2 109.4,157.2

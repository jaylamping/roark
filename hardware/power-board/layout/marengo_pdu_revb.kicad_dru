(version 1)
# No fine-pitch rule: U1, U7 (MSOP-10) and U2 (HVSSOP-8) have their pads at TI's land-pattern width (0.30 and 0.45 mm,
# schematic/tools/fine_pitch_pads.py), so every gap is at least the 0.2 mm default, which is also JLCPCB's minimum
# space for 2 oz outer copper. Until 2026-11-10 these three had a 0.15 mm courtyard rule, and U8 one until its block
# was turned (schematic/tools/u8_block.py).
# E-stop safety nets keep 1.5 mm to 54 V copper on every layer (LAYOUT_RULES.md, schematic/tools/domains.py)
(rule estop_to_54v
  (constraint clearance (min 1.5mm))
  (condition "A.hasNetclass('ESTOP') && B.hasNetclass('HV54')"))
# U1 (LM5069): the UVLO pin (E-stop class) is pin 3, 0.2 mm from SH_P on pin 2 and 0.7 mm from SH_N on pin 1 (54 V
# class). The package sets that, so between F.Cu pads, tracks and vias inside U1's courtyard the 1.5 mm rule gives way to
# the 0.2 mm default. Never a pour, never another layer. This rule comes later in the file, so it wins there.
(rule estop_at_U1
  (layer "F.Cu")
  (constraint clearance (min 0.2mm))
  (condition "A.Type != 'Zone' && B.Type != 'Zone' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')"))
